  "assessment": {
    "rationale": "Good fit for envelope-independence pressure: the draft treats the envelope as a minimal carrier for pCID-dispatched payload bytes and keeps CAS/session meaning out of any claimed envelope winner, but it does not yet prove that signatures and proofs stay stable when the same message is re-wrapped in another variant.",
    "strengths": [
      "Keeps CAS and group-session meaning in the payload protocol rather than the envelope core.",
      "Explicitly avoids a central pCID registry and does not claim this variant is the canonical winner.",
      "Unknown or incompatible interpretation fails visibly, and best-effort salvage must be marked unsupported and unverified."
    ],
    "weaknesses": [
      "No worked CAS-backed group-session example shows identical semantics across two envelope variants.",
      "The draft is unfrozen and does not show how wrapper-based signatures or references stay stable across envelope changes."
    ],
    "risks": [
      "Operators may over-trust best-effort inspection of unknown payloads.",
      "If signatures or content-addressed references bind to outer-envelope bytes, changing envelope variants could change practical semantics."
    ],
    "open_questions": [
      "What stable object should Alice or Carol record locally across experiments: payload bytes, resolved meaning, or signed wrapper bytes?",
      "Can the same group-session message be re-wrapped in a different envelope variant without re-signing or changing any CAS references?"
    ],
    "authority_boundary": "Evidence only; does not settle PromiseGrid design."
  }
