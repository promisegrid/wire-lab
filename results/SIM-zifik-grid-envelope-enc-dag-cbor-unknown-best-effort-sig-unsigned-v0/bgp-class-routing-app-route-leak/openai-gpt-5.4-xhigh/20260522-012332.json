  "assessment": {
    "rationale": "Useful only as a thin carrier: it can transport route-policy payloads and make unsupported dispatch visible, but unsigned v0 does not itself bind scope, provenance, or violation evidence. Route-leak auditing therefore depends on unspecified payload and transport conventions, leaving weak scenario coverage and high risk.",
    "strengths": [
      "Minimal [pcid,payload] envelope cleanly separates carrier bytes from routing-policy semantics.",
      "Canonical DAG-CBOR bytes preserve exact local evidence of what a peer saw.",
      "Unknown-pCID handling forces unsupported/unverified labeling instead of silent interpretation."
    ],
    "weaknesses": [
      "No envelope-level signature, authorship, or integrity for restricted-transit promises.",
      "No native structure for onward-restraint scope, relay provenance, or violation receipts.",
      "Draft leaves forwarding evidence split across wrapper, payload, or later successor layers."
    ],
    "risks": [
      "Forged, replayed, or context-stripped policy messages can leak without envelope-level accountability.",
      "Operators may act on best-effort salvage even though it is explicitly unverified.",
      "Decades-later audits may fail if payload handlers vanish and no signed provenance chain survives."
    ],
    "open_questions": [
      "Which payload protocol encodes restricted-transit scope and onward-use restraints?",
      "Which layer must carry mandatory signatures or witnesses for hop-by-hop leak evidence?",
      "How are pCID-to-spec references preserved for long-term audit without central infrastructure?"
    ],
    "authority_boundary": "Evidence only; does not settle PromiseGrid design."
  }
